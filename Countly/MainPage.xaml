<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Countly.MainPage"
             Title="Countly">
    
    <!-- Pomysl na stylowanie wzialem z https://learn.microsoft.com/pl-pl/dotnet/maui/user-interface/styles/xaml?view=net-maui-10.0 -->
    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        
        <Style x:Key="NameStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        
        <Style x:Key="ValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="52" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#6C5CE7" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#6C5CE7" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>

        <Style x:Key="MinusButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=White}" />
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#EF4444" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="12">

        <CollectionView x:Name="CountersList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.12" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" Style="{StaticResource NameStyle}" />
                            <Label Text="{Binding Value}" Style="{StaticResource ValueStyle}" TextColor="{Binding AccentColor}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="-" Style="{StaticResource MinusButton}" Clicked="OnMinus" />
                                <Button Grid.Column="1" Text="+" Style="{StaticResource MainButton}" BackgroundColor="{Binding AccentColor}" Clicked="OnPlus" />
                            </Grid>
                            <Button Text="Usuń" Style="{StaticResource DeleteButton}" Clicked="OnDelete" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="+ Dodaj licznik" Style="{StaticResource MainButton}" FontSize="18" Clicked="OnAdd" />
    </Grid>
</ContentPage>
