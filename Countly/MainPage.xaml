<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Countly.MainPage"
             Title="Countly">

    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="12">

        <CollectionView x:Name="CountersList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,12" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontSize="20" HorizontalOptions="Center" />
                            <Label Text="{Binding Value}" FontSize="36" HorizontalOptions="Center" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="-" Clicked="OnMinus" />
                                <Button Grid.Column="1" Text="+" Clicked="OnPlus" />
                            </Grid>
                            <Button Text="Usuń" BackgroundColor="Red" TextColor="White" Clicked="OnDelete" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="1" Text="Dodaj licznik" Clicked="OnAdd"/>
    </Grid>
</ContentPage>
